<Window x:Class="PigTree.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:controls="clr-namespace:PigTree.Controls"
        xmlns:vm="clr-namespace:PigTree.ViewModel"
        xmlns:conv="clr-namespace:PigTree.Converters"
        mc:Ignorable="d"
        Title="PigTree - Disk Space Analyzer"
        Height="650" Width="900"
        MinHeight="400" MinWidth="600"
        AllowDrop="True"
        Drop="OnWindowDrop"
        DragOver="OnWindowDragOver"
        Background="{DynamicResource {x:Static SystemColors.WindowBrushKey}}"
        Foreground="{DynamicResource {x:Static SystemColors.WindowTextBrushKey}}">

    <Window.Resources>
        <conv:BindingProxy x:Key="Proxy" Data="{Binding}" />
    </Window.Resources>

    <Window.InputBindings>
        <KeyBinding Key="Escape" Command="{Binding CancelCommand}" />
    </Window.InputBindings>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Top Input & Action Bar -->
        <Border Grid.Row="0"
                Padding="8"
                Background="{DynamicResource {x:Static SystemColors.ControlBrushKey}}"
                BorderBrush="{DynamicResource {x:Static SystemColors.ActiveBorderBrushKey}}"
                BorderThickness="0,0,0,1">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Column="0"
                           Text="Target Path:"
                           VerticalAlignment="Center"
                           Margin="0,0,8,0"
                           FontWeight="SemiBold"
                           Foreground="{DynamicResource {x:Static SystemColors.ControlTextBrushKey}}" />

                <TextBox x:Name="TargetPathTextBox"
                         AutomationProperties.AutomationId="TargetPathTextBox"
                         AutomationProperties.Name="Target Path"
                         Grid.Column="1"
                         Text="{Binding TargetPath, UpdateSourceTrigger=PropertyChanged}"
                         VerticalAlignment="Center"
                         Margin="0,0,8,0">
                    <TextBox.InputBindings>
                        <KeyBinding Key="Enter" Command="{Binding ScanCommand}" />
                    </TextBox.InputBindings>
                </TextBox>

                <Button x:Name="BrowseButton"
                        AutomationProperties.AutomationId="BrowseButton"
                        AutomationProperties.Name="Browse for Folder"
                        Grid.Column="2"
                        Content="_Browse..."
                        Command="{Binding BrowseCommand}"
                        Margin="0,0,8,0" />

                <!-- Prominent Scan / Cancel buttons sharing slot -->
                <StackPanel Grid.Column="3" Orientation="Horizontal">
                    <Button x:Name="ScanButton"
                            AutomationProperties.AutomationId="ScanButton"
                            AutomationProperties.Name="Start Scan"
                            Content="_Scan"
                            FontWeight="Bold"
                            Command="{Binding ScanCommand}"
                            Visibility="{Binding IsScanVisible, Converter={StaticResource BoolToVis}}" />

                    <Button x:Name="CancelButton"
                            AutomationProperties.AutomationId="CancelButton"
                            AutomationProperties.Name="Cancel Scan"
                            Content="_Cancel (Esc)"
                            FontWeight="Bold"
                            Command="{Binding CancelCommand}"
                            Visibility="{Binding IsCancelVisible, Converter={StaticResource BoolToVis}}" />
                </StackPanel>

                <!-- Compact View menu: toggles the hidden Unique Allocated column (keyboard operable) -->
                <Menu Grid.Column="4"
                      AutomationProperties.AutomationId="ViewMenu"
                      AutomationProperties.Name="View Menu"
                      VerticalAlignment="Center"
                      Margin="8,0,0,0"
                      Background="Transparent">
                    <MenuItem Header="_View"
                              AutomationProperties.AutomationId="ViewMenuItem"
                              AutomationProperties.Name="View">
                        <MenuItem Header="Show Unique Allocated Size"
                                  AutomationProperties.AutomationId="ShowUniqueAllocatedMenuItem"
                                  AutomationProperties.Name="Show Unique Allocated Size"
                                  IsCheckable="True"
                                  IsChecked="{Binding ShowUniqueAllocatedColumn, Mode=TwoWay}" />
                    </MenuItem>
                </Menu>
            </Grid>
        </Border>

        <!-- Non-Modal Actionable Error Banner -->
        <Border x:Name="ErrorBanner"
                AutomationProperties.AutomationId="ErrorBanner"
                AutomationProperties.Name="Error Banner"
                Grid.Row="1"
                Background="{DynamicResource {x:Static SystemColors.InfoBrushKey}}"
                BorderBrush="{DynamicResource {x:Static SystemColors.ActiveBorderBrushKey}}"
                BorderThickness="0,0,0,1"
                Padding="12,8"
                Visibility="{Binding HasError, Converter={StaticResource BoolToVis}}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <TextBlock x:Name="ErrorMessageTextBlock"
                           AutomationProperties.AutomationId="ErrorMessageTextBlock"
                           AutomationProperties.Name="Error Message"
                           AutomationProperties.LiveSetting="Assertive"
                           Text="{Binding ErrorMessage}"
                           TextWrapping="Wrap"
                           VerticalAlignment="Center"
                           FontWeight="Medium"
                           Foreground="{DynamicResource {x:Static SystemColors.InfoTextBrushKey}}" />

                <Button x:Name="RetryButton"
                        AutomationProperties.AutomationId="RetryButton"
                        AutomationProperties.Name="Retry Scan"
                        Grid.Column="1"
                        Content="_Retry"
                        Command="{Binding RetryCommand}"
                        Margin="8,0,4,0"
                        Padding="8,2"
                        MinHeight="22" />

                <Button x:Name="DismissButton"
                        AutomationProperties.AutomationId="DismissButton"
                        AutomationProperties.Name="Dismiss Error"
                        Grid.Column="2"
                        Content="_Dismiss"
                        Command="{Binding DismissErrorCommand}"
                        Margin="4,0,0,0"
                        Padding="8,2"
                        MinHeight="22" />
            </Grid>
        </Border>

        <!-- Flattened Virtualized Directory Tree View -->
        <controls:DirectoryTreeView x:Name="DirectoryTreeView"
                                    AutomationProperties.AutomationId="DirectoryTreeView"
                                    AutomationProperties.Name="Directory Tree View"
                                    Grid.Row="2"
                                    ItemsSource="{Binding VisibleTreeItems}"
                                    SelectedItem="{Binding SelectedTreeItem, Mode=TwoWay}"
                                    VirtualizingStackPanel.IsVirtualizing="True"
                                    VirtualizingStackPanel.VirtualizationMode="Recycling"
                                    VirtualizingStackPanel.ScrollUnit="Pixel"
                                    ScrollViewer.IsDeferredScrollingEnabled="False"
                                    ScrollViewer.HorizontalScrollBarVisibility="Auto"
                                    ScrollViewer.VerticalScrollBarVisibility="Auto"
                                    BorderThickness="0">
            <ListView.View>
                <GridView>
                    <!-- Name Column with hierarchy indent and expander toggle -->
                    <GridViewColumn Header="Name" Width="380">
                        <GridViewColumn.CellTemplate>
                            <DataTemplate DataType="{x:Type vm:TreeItemViewModel}">
                                <StackPanel Orientation="Horizontal" Margin="{Binding Level, Converter={StaticResource LevelToMargin}}">
                                    <!-- Expander toggle button for directories -->
                                    <Button Command="{Binding ToggleExpandCommand}"
                                            CommandParameter="{Binding}"
                                            AutomationProperties.AutomationId="ExpandCollapseButton"
                                            AutomationProperties.Name="Toggle Expand"
                                            Visibility="{Binding HasChildren, Converter={StaticResource BoolToVis}}"
                                            Background="Transparent"
                                            BorderThickness="0"
                                            Padding="2,0"
                                            MinWidth="16"
                                            MinHeight="16"
                                            Margin="0,0,4,0"
                                            VerticalAlignment="Center"
                                            Cursor="Hand"
                                            Focusable="False">
                                        <TextBlock Text="{Binding IsExpanded, Converter={StaticResource ExpandIconConv}}"
                                                   FontSize="10"
                                                   VerticalAlignment="Center"
                                                   Foreground="{DynamicResource {x:Static SystemColors.ControlTextBrushKey}}" />
                                    </Button>

                                    <!-- Placeholder spacer if leaf -->
                                    <Border Width="16" Height="16" Margin="0,0,4,0"
                                            Visibility="{Binding HasChildren, Converter={StaticResource InverseBoolToVis}}" />

                                    <!-- Loading indicator if expanding -->
                                    <TextBlock Text="..."
                                               Visibility="{Binding IsLoading, Converter={StaticResource BoolToVis}}"
                                               Margin="0,0,4,0"
                                               FontWeight="Bold"
                                               VerticalAlignment="Center" />

                                    <!-- Item Name -->
                                    <TextBlock Text="{Binding Name}"
                                               VerticalAlignment="Center"
                                               TextTrimming="CharacterEllipsis" />

                                    <!-- Hard link alias badge: multiple directory entries refer to one object -->
                                    <TextBlock Text="{Binding AliasBadgeText}"
                                               AutomationProperties.AutomationId="AliasBadgeTextBlock"
                                               AutomationProperties.Name="Hard link aliases"
                                               Visibility="{Binding HasAliasBadge, Converter={StaticResource BoolToVis}}"
                                               Margin="6,0,0,0"
                                               FontSize="11"
                                               VerticalAlignment="Center"
                                               Foreground="{DynamicResource {x:Static SystemColors.GrayTextBrushKey}}" />

                                    <!-- Confirmed external link indicator (shown even with a single alias) -->
                                    <TextBlock Text="{Binding ExternalLinkBadgeText}"
                                               AutomationProperties.AutomationId="ExternalLinkBadgeTextBlock"
                                               AutomationProperties.Name="Confirmed external link"
                                               Visibility="{Binding HasExternalLinkBadge, Converter={StaticResource BoolToVis}}"
                                               Margin="6,0,0,0"
                                               FontSize="11"
                                               VerticalAlignment="Center"
                                               Foreground="{DynamicResource {x:Static SystemColors.GrayTextBrushKey}}" />
                                </StackPanel>
                            </DataTemplate>
                        </GridViewColumn.CellTemplate>
                    </GridViewColumn>

                    <!-- Logical Size Column -->
                    <GridViewColumn Header="Logical Size" Width="120"
                                    DisplayMemberBinding="{Binding FormattedLogicalSize}" />

                    <!-- Referenced Allocated Column: additive physical allocation across entry paths -->
                    <GridViewColumn Header="Referenced Allocated" Width="130"
                                    DisplayMemberBinding="{Binding FormattedReferencedAllocated}" />

                    <!-- Unique Allocated Column: each distinct object counted once; hidden by default -->
                    <GridViewColumn Header="Unique Allocated"
                                    Width="{Binding Data.ShowUniqueAllocatedColumn, Source={StaticResource Proxy}, Converter={StaticResource UniqueColumnWidth}, Mode=OneWay}"
                                    DisplayMemberBinding="{Binding FormattedUniqueAllocated}" />

                    <!-- Child / Item Count Column -->
                    <GridViewColumn Header="Items" Width="90"
                                    DisplayMemberBinding="{Binding FormattedItemCount}" />

                    <!-- Scope Coverage / Status Column -->
                    <GridViewColumn Header="Coverage" Width="110"
                                    DisplayMemberBinding="{Binding ScopeCoverage}" />
                </GridView>
            </ListView.View>
        </controls:DirectoryTreeView>

        <!-- Status Bar -->
        <Border Grid.Row="3"
                Background="{DynamicResource {x:Static SystemColors.ControlBrushKey}}"
                BorderBrush="{DynamicResource {x:Static SystemColors.ActiveBorderBrushKey}}"
                BorderThickness="0,1,0,0"
                Padding="8,4">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Orientation="Horizontal">
                    <TextBlock x:Name="StatusTextBlock"
                               AutomationProperties.AutomationId="StatusTextBlock"
                               AutomationProperties.Name="Status"
                               AutomationProperties.LiveSetting="Polite"
                               Text="{Binding StatusText}"
                               VerticalAlignment="Center"
                               FontWeight="SemiBold"
                               Margin="0,0,16,0"
                               Foreground="{DynamicResource {x:Static SystemColors.ControlTextBrushKey}}" />

                    <!-- Summary-level uncertainty indicator for indeterminate external references (AC-7) -->
                    <TextBlock x:Name="ExternalReferenceSummaryTextBlock"
                               AutomationProperties.AutomationId="ExternalReferenceSummaryTextBlock"
                               AutomationProperties.Name="External link uncertainty summary"
                               AutomationProperties.LiveSetting="Polite"
                               Text="{Binding ExternalReferenceSummaryText}"
                               Visibility="{Binding HasExternalReferenceSummary, Converter={StaticResource BoolToVis}}"
                               VerticalAlignment="Center"
                               Margin="0,0,16,0"
                               TextTrimming="CharacterEllipsis"
                               Foreground="{DynamicResource {x:Static SystemColors.ControlTextBrushKey}}" />

                    <TextBlock Text="{Binding CurrentDirectory}"
                               VerticalAlignment="Center"
                               TextTrimming="CharacterEllipsis"
                               Foreground="{DynamicResource {x:Static SystemColors.GrayTextBrushKey}}" />
                </StackPanel>

                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="Elapsed: "
                               FontWeight="SemiBold"
                               Foreground="{DynamicResource {x:Static SystemColors.ControlTextBrushKey}}" />
                    <TextBlock Text="{Binding ElapsedText}"
                               Margin="0,0,12,0"
                               Foreground="{DynamicResource {x:Static SystemColors.ControlTextBrushKey}}" />

                    <TextBlock Text="Files: "
                               FontWeight="SemiBold"
                               Foreground="{DynamicResource {x:Static SystemColors.ControlTextBrushKey}}" />
                    <TextBlock Text="{Binding ObservedFilesText}"
                               Margin="0,0,12,0"
                               Foreground="{DynamicResource {x:Static SystemColors.ControlTextBrushKey}}" />

                    <TextBlock Text="Dirs: "
                               FontWeight="SemiBold"
                               Foreground="{DynamicResource {x:Static SystemColors.ControlTextBrushKey}}" />
                    <TextBlock Text="{Binding ObservedDirectoriesText}"
                               Margin="0,0,12,0"
                               Foreground="{DynamicResource {x:Static SystemColors.ControlTextBrushKey}}" />

                    <TextBlock Text="Size: "
                               FontWeight="SemiBold"
                               Foreground="{DynamicResource {x:Static SystemColors.ControlTextBrushKey}}" />
                    <TextBlock Text="{Binding ObservedLogicalSizeText}"
                               Foreground="{DynamicResource {x:Static SystemColors.ControlTextBrushKey}}" />
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>
